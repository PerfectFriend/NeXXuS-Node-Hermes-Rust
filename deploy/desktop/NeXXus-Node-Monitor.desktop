[Desktop Entry]
Name=NeXXus Node Monitor
GenericName=NeXXus Node Guardian
Comment=Ангел-хранитель ноды NeXXus — мониторинг, автозапуск, уведомления Telegram
Exec=/home/thomas/Projects/NeXXus-Node/deploy/desktop/nexxus-desktop-launch
Icon=nexxus-desktop
Terminal=false
Type=Application
Categories=Network;System;Monitor;
StartupNotify=true
StartupWMClass=nexxus-desktop
X-GNOME-UsesNotifications=true
Actions=Show;Quit

[Desktop Action Show]
Name=Показать панель управления
Exec=/home/thomas/build/cache/cargo-target/release/nexxus-desktop

[Desktop Action Quit]
Name=Выход
Exec=pkill -f nexxus-desktop
