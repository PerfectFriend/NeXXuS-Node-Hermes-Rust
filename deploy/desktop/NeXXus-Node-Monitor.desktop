[Desktop Entry]
Type=Application
Name=NeXXus Node Monitor
GenericName=NeXXus Node Daemon Monitor
Comment=Десктоп-монитор узла NeXXus с системным треем и панелями статуса
Exec=sh -c 'if ! pgrep -f "nexxusd.*store.redb" > /dev/null; then /home/thomas/build/cache/cargo-target/release/nexxusd /home/thomas/.nexxus/store.redb & sleep 2; fi; if [ -z "${WAYLAND_DISPLAY:-}" ]; then for wl in /run/user/$(id -u)/wayland-*; do if [ -S "$wl" ]; then export WAYLAND_DISPLAY=$(basename "$wl"); break; fi; done; fi; export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"; /home/thomas/build/cache/cargo-target/release/nexxus-desktop'
Icon=/home/thomas/Projects/NeXXus-Node/nexxus-desktop/src-tauri/icons/icon.png
Terminal=false
Categories=Network;Monitor;System;
StartupNotify=true
Keywords=nexxus;node;monitor;p2p;daemon;
