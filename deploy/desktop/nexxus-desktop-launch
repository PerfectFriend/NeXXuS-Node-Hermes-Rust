#!/usr/bin/env bash
# Запуск связки nexxusd + nexxus-desktop для тестирования
set -e

STORE_PATH="/home/thomas/.nexxus/store.redb"
DAEMON="/home/thomas/build/cache/cargo-target/release/nexxusd"
DESKTOP="/home/thomas/build/cache/cargo-target/release/nexxus-desktop"

mkdir -p "$(dirname "$STORE_PATH")"

# Запускаем nexxusd если не запущен
if ! pgrep -f "nexxusd.*store.redb" > /dev/null; then
    echo ">>> Запуск nexxusd на $STORE_PATH..."
    "$DAEMON" "$STORE_PATH" &
    DAEMON_PID=$!
    echo ">>> nexxusd PID: $DAEMON_PID"
    sleep 2
else
    echo ">>> nexxusd уже запущен"
fi

# Находим Wayland дисплей
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for wl in /run/user/$(id -u)/wayland-*; do
        if [ -S "$wl" ]; then
            export WAYLAND_DISPLAY=$(basename "$wl")
            break
        fi
    done
fi
echo ">>> Wayland дисплей: ${WAYLAND_DISPLAY:-не найден}"

# Проверяем порты
echo ">>> Проверка портов..."
ss -tlnp | grep -E '4001|4010' || echo "Порты не найдены!"

# Запускаем nexxus-desktop
echo ">>> Запуск nexxus-desktop..."
"$DESKTOP" &
DESKTOP_PID=$!
echo ">>> nexxus-desktop PID: $DESKTOP_PID"

echo ">>> Готово. Нажмите Enter для остановки..."
read -r

# Очистка
kill "$DESKTOP_PID" 2>/dev/null || true
kill "$DAEMON_PID" 2>/dev/null || true
echo ">>> Остановлено"
