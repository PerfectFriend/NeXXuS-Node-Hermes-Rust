#!/usr/bin/env bash
# Запуск NeXXus Node Monitor (Ангел-хранитель ноды).
# Монитор запускается ПЕРВЫМ и сам запускает nexxusd, мониторит здоровье,
# автоперезапускает при падении и отправляет уведомления в Telegram.

set -e

DESKTOP="/home/thomas/build/cache/cargo-target/release/nexxus-desktop"

# Находим Wayland дисплей
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for wl in /run/user/$(id -u)/wayland-*; do
        if [ -S "$wl" ]; then
            export WAYLAND_DISPLAY=$(basename "$wl")
            break
        fi
    done
fi
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

echo ">>> Wayland дисплей: ${WAYLAND_DISPLAY}"
echo ">>> Запуск NeXXus Node Monitor (Гардиан)..."
echo ">>> Монитор сам запустит nexxusd и будет следить за его здоровьем."
echo ">>> Для уведомлений в Telegram задайте NEXXUS_TG_BOT_TOKEN и NEXXUS_TG_CHAT_ID."

"$DESKTOP" &

DESKTOP_PID=$!
echo ">>> nexxus-desktop PID: $DESKTOP_PID"

wait $DESKTOP_PID
