[Unit]
Description=NeXXus Node Monitor (Гардиан — ангел-хранитель ноды)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/Projects/NeXXus-Node/nexxus-desktop
Environment="WAYLAND_DISPLAY=wayland-0"
# Установите токены перед запуском:
#   systemctl --user set-environment NEXXUS_TG_BOT_TOKEN="<token>"
#   systemctl --user set-environment NEXXUS_TG_CHAT_ID="143293811"
# Или через ~/.config/environment.d/nexxus-monitor.env
ExecStart=/home/thomas/build/cache/cargo-target/release/nexxus-desktop
Restart=always
RestartSec=5
# Не убивать nexxusd при остановке монитора
IgnoreSIGPIPE=no

[Install]
WantedBy=graphical-session.target
