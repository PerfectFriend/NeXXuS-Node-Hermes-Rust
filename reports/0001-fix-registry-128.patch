 	return out
 }
 
-// GenerateNodeID creates a short unique node identifier.
+// nodeIDFrom собирает идентификатор из публичного ключа владельца и соли.
+// Ключ входит в хеш, поэтому ID нельзя перенести на другой ключ; соль
+// гарантирует, что перезапуск с тем же ключом даёт новый идентификатор.
+// Функция без похода в крипто-генератор — идентичность проверяется
+// детерминированно, без вероятностных осей.
+func nodeIDFrom(pubkey string, salt [16]byte) string {
+	h := sha256.New()
+	h.Write([]byte(pubkey))
+	h.Write([]byte{0})
+	h.Write(salt[:])
+	return "node-" + hex.EncodeToString(h.Sum(nil)[:16])
+}
+
+// GenerateNodeID создаёт сетевой идентификатор узла.
+//
+// Диапазон прежней реализации был 32 бита, а параметр pubkey не
+// использовался вовсе. Коллизии при парадоксе дней рождения на
+// 32 битах достигают 50% примерно к 74 тысячам узлов, а math/rand
+// не является источником, пригодным для сетевых идентификаторов.
 func GenerateNodeID(pubkey string) string {
-	h := fmt.Sprintf("%x", struct{ uint32 }{rand.Uint32()})
-	return "node-" + h[:8]
+	var salt [16]byte
+	if _, err := rand.Read(salt[:]); err != nil {
+		// Отказ генератора означает, что выданный ID был бы предсказуемым.
+		// Лучше явная остановка, чем молчаливо слабая идентичность.
+		panic("registry: crypto/rand unavailable: " + err.Error())
+	}
+	return nodeIDFrom(pubkey, salt)
 }
