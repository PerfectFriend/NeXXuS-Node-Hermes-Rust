orchestration/
Projects/*/

# Скомпилированный Python-код не должен попадать в индекс
__pycache__/
*.pyc
*.pyo

# Согласованно с правилом Projects/*/ — каталог проектов без 's'
Project1*/__pycache__/

# Протокол Живого Кода: проекты живут в СОБСТВЕННЫХ репозиториях
# (remotes flash+github), релизные снимки — производное от них
Project1/
Project2/
Project3/
Project4/
Releases/

# Служебные бэкапы и временные файлы — в индекс не попадают
*.bak
*.tmp
*.md.bak-*
